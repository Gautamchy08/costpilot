# CostPilot — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── Firebase CLIENT (browser-side, safe to expose) ──────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase ADMIN (server-side only, never expose to browser) ───────────
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# Paste the private_key value from the JSON — keep the -----BEGIN/END PRIVATE KEY----- lines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Gemini API (AI-generated summaries) ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Resend (transactional emails) ───────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── App Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
